<Window x:Class="BraillePrinter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="점자 프린터 HMI"
        Height="800" Width="1280"
        MinHeight="600" MinWidth="900"
        Background="#EEEEEE">

    <Window.Resources>
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PanelHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#555"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ 툴바 ═══ -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#CCCCCC" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="12,8">

                <TextBlock Text="점자 프린터"
                           FontSize="16" FontWeight="Bold"
                           Foreground="#1565C0"
                           VerticalAlignment="Center"
                           Margin="0,0,20,0"/>

                <Button x:Name="BtnConvert"
                        Style="{StaticResource ToolBtn}"
                        Content="변환"
                        Background="#1565C0" Foreground="White"
                        Click="BtnConvert_Click"/>

                <Button x:Name="BtnClear"
                        Style="{StaticResource ToolBtn}"
                        Content="지우기"
                        Click="BtnClear_Click"/>

                <Rectangle Width="1" Height="22" Fill="#CCCCCC" Margin="8,0"/>

                <Button x:Name="BtnParam"
                        Style="{StaticResource ToolBtn}"
                        Content="파라미터 설정"
                        Click="BtnParam_Click"/>

                <Button x:Name="BtnLog"
                        Style="{StaticResource ToolBtn}"
                        Content="로그"
                        Click="BtnLog_Click"/>

                <Rectangle Width="1" Height="22" Fill="#CCCCCC" Margin="8,0"/>

                <!-- 시리얼 연결 -->
                <TextBlock Text="COM:" VerticalAlignment="Center" Margin="4,0"/>
                <ComboBox x:Name="CmbPort" Width="90" Height="28"
                          VerticalAlignment="Center" Margin="2,0"/>
                <Button x:Name="BtnRefreshPorts"
                        Style="{StaticResource ToolBtn}"
                        Content="새로고침"
                        Click="BtnRefreshPorts_Click"/>
                <Button x:Name="BtnConnect"
                        Style="{StaticResource ToolBtn}"
                        Content="연결"
                        Background="#388E3C" Foreground="White"
                        Click="BtnConnect_Click"/>

                <Rectangle Width="1" Height="22" Fill="#CCCCCC" Margin="8,0"/>

                <!-- Home / Print -->
                <Button x:Name="BtnHome"
                        Style="{StaticResource ToolBtn}"
                        Content="HOME"
                        Background="#F57C00" Foreground="White"
                        IsEnabled="False"
                        Click="BtnHome_Click"/>

                <Button x:Name="BtnPrint"
                        Style="{StaticResource ToolBtn}"
                        Content="인쇄"
                        Background="#D32F2F" Foreground="White"
                        IsEnabled="False"
                        Click="BtnPrint_Click"/>

                <Button x:Name="BtnPause"
                        Style="{StaticResource ToolBtn}"
                        Content="일시정지"
                        Background="#F57C00" Foreground="White"
                        IsEnabled="False"
                        Click="BtnPause_Click"/>

                <Button x:Name="BtnResume"
                        Style="{StaticResource ToolBtn}"
                        Content="재개"
                        Background="#388E3C" Foreground="White"
                        IsEnabled="False"
                        Click="BtnResume_Click"/>

                <Button x:Name="BtnStop"
                        Style="{StaticResource ToolBtn}"
                        Content="취소(E-Stop)"
                        IsEnabled="False"
                        Click="BtnStop_Click"/>
            </StackPanel>
        </Border>

        <!-- ═══ GRBL 상태 바 ═══ -->
        <Border Grid.Row="1"
                Background="#F5F5F5"
                BorderBrush="#CCCCCC" BorderThickness="0,0,0,1"
                Padding="12,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="GRBL:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Border x:Name="StateIndicator"
                        Background="#9E9E9E"
                        CornerRadius="3"
                        Padding="8,2" Margin="0,0,12,0">
                    <TextBlock x:Name="TxtGrblState"
                               Text="Disconnected"
                               Foreground="White"
                               FontWeight="Bold"
                               FontSize="11"/>
                </Border>
                <TextBlock Text="위치:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBlock x:Name="TxtMachinePos"
                           Text="X:0.000  Y:0.000"
                           VerticalAlignment="Center"
                           FontFamily="Consolas"
                           FontSize="12"
                           Margin="0,0,16,0"/>
                <TextBlock x:Name="TxtHomedStatus"
                           Text="[HOME 필요]"
                           Foreground="#D32F2F"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"/>
                <ProgressBar x:Name="JobProgress"
                             Width="200" Height="16"
                             Minimum="0" Maximum="100"
                             Visibility="Collapsed"
                             VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtJobProgress"
                           Text=""
                           VerticalAlignment="Center"
                           Margin="6,0,0,0"
                           FontSize="11"/>
            </StackPanel>
        </Border>

        <!-- ═══ 메인 콘텐츠 ═══ -->
        <Grid Grid.Row="2" Margin="12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="200"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── 왼쪽 패널: 텍스트 입력 ── -->
            <DockPanel Grid.Column="0">

                <TextBlock DockPanel.Dock="Top"
                           Style="{StaticResource PanelHeader}"
                           Text="한글 텍스트 입력"/>

                <Border DockPanel.Dock="Bottom"
                        Background="White"
                        BorderBrush="#CCCCCC" BorderThickness="1"
                        CornerRadius="4"
                        Padding="10,8"
                        Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PanelHeader}"
                                   Text="변환 정보" Margin="0,0,0,4"/>

                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="입력 글자수:" Width="90" Style="{StaticResource StatusText}"/>
                            <TextBlock x:Name="InfoCharCount" Text="0" Style="{StaticResource StatusText}" FontWeight="Medium"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="점자 셀 수:"  Width="90" Style="{StaticResource StatusText}"/>
                            <TextBlock x:Name="InfoCellCount" Text="0" Style="{StaticResource StatusText}" FontWeight="Medium"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="점 개수:"     Width="90" Style="{StaticResource StatusText}"/>
                            <TextBlock x:Name="InfoDotCount"  Text="0" Style="{StaticResource StatusText}" FontWeight="Medium"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="사용 줄:"     Width="90" Style="{StaticResource StatusText}"/>
                            <TextBlock x:Name="InfoLineCount" Text="0" Style="{StaticResource StatusText}" FontWeight="Medium"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="셀 용량:"     Width="90" Style="{StaticResource StatusText}"/>
                            <TextBlock x:Name="InfoCapacity"  Text="-" Style="{StaticResource StatusText}" FontWeight="Medium"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="G-Code 줄수:" Width="90" Style="{StaticResource StatusText}"/>
                            <TextBlock x:Name="InfoGCodeLines" Text="0" Style="{StaticResource StatusText}" FontWeight="Medium"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#CCCCCC" BorderThickness="1"
                        Background="White" CornerRadius="4">
                    <TextBox x:Name="InputTextBox"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontSize="14"
                             FontFamily="맑은 고딕, Malgun Gothic"
                             Padding="8"
                             BorderThickness="0"
                             VerticalAlignment="Stretch"
                             TextChanged="InputTextBox_TextChanged"
                             ToolTip="한글 텍스트를 입력하세요"/>
                </Border>
            </DockPanel>

            <!-- ── 구분선 ── -->
            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Width="4"
                          Background="#CCCCCC"
                          Cursor="SizeWE"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- ── 오른쪽 패널: 탭 (점자 미리보기 / G-Code / 좌표) ── -->
            <TabControl x:Name="MainTabControl" Grid.Column="2">

                <!-- 탭1: 점자 미리보기 -->
                <TabItem Header="점자 미리보기">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Ctrl+휠: 확대/축소"
                                   FontSize="10" Foreground="#888"
                                   Margin="4,2" HorizontalAlignment="Right"/>
                        <ScrollViewer x:Name="BrailleScrollViewer"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      Background="#909090"
                                      PreviewMouseWheel="OnPreviewZoom">
                            <Border x:Name="PaperBorder"
                                    Background="White"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Margin="24">
                                <Border.LayoutTransform>
                                    <ScaleTransform x:Name="BrailleScale" ScaleX="1" ScaleY="1"/>
                                </Border.LayoutTransform>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="3"
                                                      Opacity="0.35" Color="Black"/>
                                </Border.Effect>
                                <Canvas x:Name="BrailleCanvas"
                                        Background="White"
                                        ClipToBounds="True"/>
                            </Border>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>

                <!-- 탭2: 경로 미리보기 -->
                <TabItem Header="경로 미리보기">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Ctrl+휠: 확대/축소"
                                   FontSize="10" Foreground="#888"
                                   Margin="4,2" HorizontalAlignment="Right"/>
                        <ScrollViewer x:Name="PathScrollViewer"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      Background="#909090"
                                      PreviewMouseWheel="OnPreviewZoom">
                            <Border x:Name="PathPaperBorder"
                                    Background="White"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Margin="24">
                                <Border.LayoutTransform>
                                    <ScaleTransform x:Name="PathScale" ScaleX="1" ScaleY="1"/>
                                </Border.LayoutTransform>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="3"
                                                      Opacity="0.35" Color="Black"/>
                                </Border.Effect>
                                <Canvas x:Name="PathCanvas"
                                        Background="White"
                                        ClipToBounds="True"/>
                            </Border>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>

                <!-- 탭3: G-Code -->
                <TabItem Header="G-Code">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="#F5F5F5" Padding="8,4"
                                BorderBrush="#CCC" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="생성된 G-Code 시퀀스" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Button Content="복사" Padding="10,2" Click="BtnCopyGCode_Click"
                                        Cursor="Hand"/>
                            </StackPanel>
                        </Border>
                        <TextBox x:Name="TxtGCode"
                                 IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas, Courier New"
                                 FontSize="13"
                                 Background="White"
                                 Padding="8"
                                 TextWrapping="NoWrap"/>
                    </DockPanel>
                </TabItem>

                <!-- 탭3: 좌표 테이블 -->
                <TabItem Header="좌표 테이블">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="#F5F5F5" Padding="8,4"
                                BorderBrush="#CCC" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="펀칭 좌표 (mm, 용지 좌상단 기준)" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Button Content="복사" Padding="10,2" Click="BtnCopyCoords_Click"
                                        Cursor="Hand"/>
                            </StackPanel>
                        </Border>
                        <TextBox x:Name="TxtCoordinates"
                                 IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas, Courier New"
                                 FontSize="12"
                                 Background="White"
                                 Padding="8"
                                 TextWrapping="NoWrap"/>
                    </DockPanel>
                </TabItem>

                <!-- 탭4: 통신 로그 -->
                <TabItem Header="수동 제어 (Jog)">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20" MaxWidth="520" HorizontalAlignment="Left">

                            <TextBlock Text="수동 이동 (Jog)"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="#1565C0"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="GRBL이 Idle 상태이고 연결되어 있어야 사용 가능합니다. $J=G91 명령으로 상대이동합니다."
                                       FontSize="11" Foreground="#777"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,14"/>

                            <!-- 스텝 사이즈 -->
                            <TextBlock Text="이동 거리 (mm)" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                            <StackPanel x:Name="JogStepGroup" Orientation="Horizontal" Margin="0,0,0,12">
                                <RadioButton Content="0.1"  GroupName="JogStep" Tag="0.1"  Margin="0,0,12,0"
                                             VerticalAlignment="Center" FontSize="12"/>
                                <RadioButton Content="1"    GroupName="JogStep" Tag="1"    Margin="0,0,12,0"
                                             VerticalAlignment="Center" FontSize="12" IsChecked="True"/>
                                <RadioButton Content="10"   GroupName="JogStep" Tag="10"   Margin="0,0,12,0"
                                             VerticalAlignment="Center" FontSize="12"/>
                                <RadioButton Content="50"   GroupName="JogStep" Tag="50"   Margin="0,0,12,0"
                                             VerticalAlignment="Center" FontSize="12"/>
                                <RadioButton Content="100"  GroupName="JogStep" Tag="100"
                                             VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>

                            <!-- 이동 속도 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <TextBlock Text="이동 속도 (F)" FontWeight="SemiBold" FontSize="12"
                                           VerticalAlignment="Center" Width="100"/>
                                <TextBox x:Name="TbJogFeed" Width="90" Padding="4,3"
                                         Text="1500" FontSize="12"
                                         VerticalContentAlignment="Center"/>
                                <TextBlock Text="mm/min" VerticalAlignment="Center"
                                           FontSize="11" Foreground="#777" Margin="6,0,0,0"/>
                            </StackPanel>

                            <!-- 방향 버튼 (D-Pad 레이아웃) -->
                            <TextBlock Text="방향" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                            <Grid HorizontalAlignment="Left" Margin="0,0,0,14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Y+ (위) -->
                                <Button x:Name="BtnJogYPlus"
                                        Grid.Row="0" Grid.Column="1"
                                        Content="▲&#10;Y+" FontSize="13"
                                        Width="64" Height="56" Margin="3"
                                        Background="#1565C0" Foreground="White"
                                        Click="BtnJogYPlus_Click"/>

                                <!-- X- (왼쪽) -->
                                <Button x:Name="BtnJogXMinus"
                                        Grid.Row="1" Grid.Column="0"
                                        Content="◀&#10;X-" FontSize="13"
                                        Width="64" Height="56" Margin="3"
                                        Background="#1565C0" Foreground="White"
                                        Click="BtnJogXMinus_Click"/>

                                <!-- 중앙 (Jog Cancel) -->
                                <Button x:Name="BtnJogCancel"
                                        Grid.Row="1" Grid.Column="1"
                                        Content="중지" FontSize="11"
                                        Width="64" Height="56" Margin="3"
                                        Background="#9E9E9E" Foreground="White"
                                        Click="BtnJogCancel_Click"/>

                                <!-- X+ (오른쪽) -->
                                <Button x:Name="BtnJogXPlus"
                                        Grid.Row="1" Grid.Column="2"
                                        Content="▶&#10;X+" FontSize="13"
                                        Width="64" Height="56" Margin="3"
                                        Background="#1565C0" Foreground="White"
                                        Click="BtnJogXPlus_Click"/>

                                <!-- Y- (아래) -->
                                <Button x:Name="BtnJogYMinus"
                                        Grid.Row="2" Grid.Column="1"
                                        Content="▼&#10;Y-" FontSize="13"
                                        Width="64" Height="56" Margin="3"
                                        Background="#1565C0" Foreground="White"
                                        Click="BtnJogYMinus_Click"/>
                            </Grid>

                            <!-- 보조 기능 -->
                            <TextBlock Text="보조 기능" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnGoOrigin"
                                        Content="원점 이동 (G0 X0 Y0)"
                                        Padding="12,6" FontSize="12"
                                        Margin="0,0,8,0"
                                        Click="BtnGoOrigin_Click"/>
                                <Button x:Name="BtnKillAlarmLock"
                                        Content="$X (알람 해제)"
                                        Padding="12,6" FontSize="12"
                                        Background="#F57C00" Foreground="White"
                                        Click="BtnKillAlarmLock_Click"/>
                            </StackPanel>
                            <TextBlock Text="※ $X는 홈잉 없이 알람만 해제합니다 — 위치 신뢰성이 보장되지 않으므로 가급적 HOME을 사용하세요."
                                       FontSize="10" Foreground="#D32F2F"
                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="통신 로그">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="#F5F5F5" Padding="8,4"
                                BorderBrush="#CCC" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="GRBL 시리얼 통신 로그" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Button Content="지우기" Padding="10,2" Click="BtnClearSerialLog_Click"
                                        Cursor="Hand"/>
                            </StackPanel>
                        </Border>
                        <TextBox x:Name="TxtSerialLog"
                                 IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas, Courier New"
                                 FontSize="12"
                                 Background="#1E1E1E"
                                 Foreground="#DCDCDC"
                                 Padding="8"
                                 TextWrapping="NoWrap"/>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- ═══ 상태바 ═══ -->
        <StatusBar Grid.Row="3"
                   Background="White"
                   BorderBrush="#CCCCCC" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusMessage"
                           Style="{StaticResource StatusText}"
                           Text="준비"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="StatusParams"
                           Style="{StaticResource StatusText}"/>
            </StatusBarItem>
        </StatusBar>

    </Grid>
</Window>
