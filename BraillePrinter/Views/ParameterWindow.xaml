<Window x:Class="BraillePrinter.Views.ParameterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="파라미터 설정"
        Height="780" Width="580"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">

    <Window.Resources>
        <!-- 구분선 스타일 -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>

        <!-- 파라미터 행 레이아웃 -->
        <Style x:Key="ParamLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="200"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#444"/>
        </Style>

        <Style x:Key="ParamTextBox" TargetType="TextBox">
            <Setter Property="Width" Value="80"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#BBBBBB"/>
        </Style>

        <Style x:Key="UnitLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Foreground" Value="#777"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="RangeLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="Foreground" Value="#999"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontStyle" Value="Italic"/>
        </Style>

        <!-- 읽기 전용 계산값 -->
        <Style x:Key="CalcValue" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="80"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#1565C0"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>

        <!-- 버튼 -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Width" Value="90"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="6,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── 파라미터 입력 영역 ── -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- 점자 물리 규격 -->
                <TextBlock Style="{StaticResource SectionLabel}" Text="점자 물리 규격 (한국 점자 규정 2020)"/>
                <Separator Margin="0,0,0,8"/>

                <!-- 점간 거리 -->
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource ParamLabel}" Text="점간 거리 (셀 내부)"/>
                    <TextBox  x:Name="TbDotSpacing"   Style="{StaticResource ParamTextBox}"/>
                    <TextBlock Style="{StaticResource UnitLabel}"  Text="mm"/>
                    <TextBlock Style="{StaticResource RangeLabel}" Text="규격: 2.3 ~ 2.5"/>
                </StackPanel>

                <!-- 자간 거리 -->
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource ParamLabel}" Text="자간 거리 (셀 사이)"/>
                    <TextBox  x:Name="TbCellSpacing"  Style="{StaticResource ParamTextBox}"/>
                    <TextBlock Style="{StaticResource UnitLabel}"  Text="mm"/>
                    <TextBlock Style="{StaticResource RangeLabel}" Text="규격: 5.5 ~ 6.9"/>
                </StackPanel>

                <!-- 줄간 거리 -->
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource ParamLabel}" Text="줄간 거리"/>
                    <TextBox  x:Name="TbLineSpacing"  Style="{StaticResource ParamTextBox}"/>
                    <TextBlock Style="{StaticResource UnitLabel}"  Text="mm"/>
                    <TextBlock Style="{StaticResource RangeLabel}" Text="규격: ~10.0"/>
                </StackPanel>

                <!-- 용지 여백 -->
                <TextBlock Style="{StaticResource SectionLabel}" Text="용지 여백"/>
                <Separator Margin="0,0,0,8"/>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource ParamLabel}" Text="좌측 여백"/>
                    <TextBox  x:Name="TbMarginLeft"   Style="{StaticResource ParamTextBox}"/>
                    <TextBlock Style="{StaticResource UnitLabel}" Text="mm"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource ParamLabel}" Text="상단 여백"/>
                    <TextBox  x:Name="TbMarginTop"    Style="{StaticResource ParamTextBox}"/>
                    <TextBlock Style="{StaticResource UnitLabel}" Text="mm"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource ParamLabel}" Text="우측 여백"/>
                    <TextBox  x:Name="TbMarginRight"  Style="{StaticResource ParamTextBox}"/>
                    <TextBlock Style="{StaticResource UnitLabel}" Text="mm"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource ParamLabel}" Text="하단 여백"/>
                    <TextBox  x:Name="TbMarginBottom" Style="{StaticResource ParamTextBox}"/>
                    <TextBlock Style="{StaticResource UnitLabel}" Text="mm"/>
                </StackPanel>

                <!-- 용지 크기 -->
                <TextBlock Style="{StaticResource SectionLabel}" Text="용지 크기"/>
                <Separator Margin="0,0,0,8"/>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource ParamLabel}" Text="용지 너비"/>
                    <TextBox  x:Name="TbPaperWidth"   Style="{StaticResource ParamTextBox}"/>
                    <TextBlock Style="{StaticResource UnitLabel}" Text="mm"/>
                    <TextBlock Style="{StaticResource RangeLabel}" Text="A4 = 210"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource ParamLabel}" Text="용지 높이"/>
                    <TextBox  x:Name="TbPaperHeight"  Style="{StaticResource ParamTextBox}"/>
                    <TextBlock Style="{StaticResource UnitLabel}" Text="mm"/>
                    <TextBlock Style="{StaticResource RangeLabel}" Text="A4 = 297"/>
                </StackPanel>

                <!-- 화면 설정 -->
                <TextBlock Style="{StaticResource SectionLabel}" Text="화면 표시"/>
                <Separator Margin="0,0,0,8"/>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource ParamLabel}" Text="표시 배율"/>
                    <TextBox  x:Name="TbDisplayScale" Style="{StaticResource ParamTextBox}"/>
                    <TextBlock Style="{StaticResource UnitLabel}" Text="px/mm"/>
                    <TextBlock Style="{StaticResource RangeLabel}" Text="권장: 2.0 ~ 4.0"/>
                </StackPanel>

                <!-- 계산 결과 (읽기 전용) -->
                <TextBlock Style="{StaticResource SectionLabel}" Text="계산 결과 (읽기 전용)"/>
                <Separator Margin="0,0,0,8"/>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource ParamLabel}" Text="한 줄당 최대 셀 수"/>
                    <TextBlock x:Name="TbCalcCellsPerLine" Style="{StaticResource CalcValue}"/>
                    <TextBlock Style="{StaticResource UnitLabel}" Text="셀"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource ParamLabel}" Text="최대 줄 수"/>
                    <TextBlock x:Name="TbCalcMaxLines" Style="{StaticResource CalcValue}"/>
                    <TextBlock Style="{StaticResource UnitLabel}" Text="줄"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource ParamLabel}" Text="총 셀 용량"/>
                    <TextBlock x:Name="TbCalcTotalCells" Style="{StaticResource CalcValue}"/>
                    <TextBlock Style="{StaticResource UnitLabel}" Text="셀"/>
                </StackPanel>

                <!-- G-Code 출력 설정 -->
                <TextBlock Style="{StaticResource SectionLabel}" Text="G-Code 출력 설정"/>
                <Separator Margin="0,0,0,8"/>

                <!-- 출력 모드 -->
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource ParamLabel}" Text="출력 모드"/>
                    <RadioButton x:Name="RbStopAndPunch"
                                 Content="정지 찍기"
                                 VerticalAlignment="Center"
                                 Margin="0,0,16,0"
                                 Checked="PrintModeRadio_Changed"/>
                    <RadioButton x:Name="RbContinuousScan"
                                 Content="연속 스캔"
                                 VerticalAlignment="Center"
                                 Checked="PrintModeRadio_Changed"/>
                </StackPanel>

                <!-- 급속 이동 속도 -->
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource ParamLabel}" Text="급속 이동 속도 (G0 F)"/>
                    <TextBox x:Name="TbFeedRate" Style="{StaticResource ParamTextBox}"/>
                    <TextBlock Style="{StaticResource UnitLabel}" Text="mm/min"/>
                    <TextBlock Style="{StaticResource RangeLabel}" Text="권장: 1000 ~ 5000"/>
                </StackPanel>

                <!-- 핀 내려찍기 유지 시간 -->
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource ParamLabel}" Text="핀 내려찍기 대기 (M3 후)"/>
                    <TextBox x:Name="TbPunchDwell" Style="{StaticResource ParamTextBox}"/>
                    <TextBlock Style="{StaticResource UnitLabel}" Text="초"/>
                    <TextBlock Style="{StaticResource RangeLabel}" Text="권장: 0.1 ~ 1.0"/>
                </StackPanel>

                <!-- 핀 복귀 대기 시간 -->
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource ParamLabel}" Text="핀 복귀 대기 (M5 후)"/>
                    <TextBox x:Name="TbRetractDwell" Style="{StaticResource ParamTextBox}"/>
                    <TextBlock Style="{StaticResource UnitLabel}" Text="초"/>
                    <TextBlock Style="{StaticResource RangeLabel}" Text="0이면 생략. 권장: 0.05 ~ 0.3"/>
                </StackPanel>

                <!-- 연속 스캔 설정 (스캔 모드 선택 시 활성 / GRBL $32=1 필요) -->
                <StackPanel x:Name="PanelScanSettings" IsEnabled="False" Opacity="0.45" Margin="0,6,0,0">
                    <TextBlock Style="{StaticResource SectionLabel}" Text="연속 스캔 설정  (GRBL $32=1 레이저 모드 필요)"/>
                    <Separator Margin="0,0,0,8"/>

                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Style="{StaticResource ParamLabel}" Text="스캔 이동 속도 (G1 F)"/>
                        <TextBox x:Name="TbScanFeedRate" Style="{StaticResource ParamTextBox}"/>
                        <TextBlock Style="{StaticResource UnitLabel}" Text="mm/min"/>
                        <TextBlock Style="{StaticResource RangeLabel}" Text="권장: 500 ~ 3000"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Style="{StaticResource ParamLabel}" Text="M3 선발사 Offset"/>
                        <TextBox x:Name="TbScanM3Offset" Style="{StaticResource ParamTextBox}"/>
                        <TextBlock Style="{StaticResource UnitLabel}" Text="mm"/>
                        <TextBlock Style="{StaticResource RangeLabel}" Text="목표 위치보다 앞에서 ON"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Style="{StaticResource ParamLabel}" Text="M5 후발사 Offset"/>
                        <TextBox x:Name="TbScanM5Offset" Style="{StaticResource ParamTextBox}"/>
                        <TextBlock Style="{StaticResource UnitLabel}" Text="mm"/>
                        <TextBlock Style="{StaticResource RangeLabel}" Text="목표 위치를 지나서 OFF"/>
                    </StackPanel>
                </StackPanel>

                <!-- 기계 원점 오프셋 -->
                <TextBlock Style="{StaticResource SectionLabel}" Text="기계 원점 오프셋"/>
                <Separator Margin="0,0,0,8"/>
                <TextBlock Text="홈 완료 후 실제 인쇄 시작 위치를 조정합니다. 모든 G-Code 좌표에 더해집니다."
                           FontSize="11" Foreground="#777" TextWrapping="Wrap" Margin="0,0,0,8"/>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource ParamLabel}" Text="X 오프셋"/>
                    <TextBox x:Name="TbOriginOffsetX" Style="{StaticResource ParamTextBox}"/>
                    <TextBlock Style="{StaticResource UnitLabel}" Text="mm"/>
                    <TextBlock Style="{StaticResource RangeLabel}" Text="음수 가능. 기본값: 0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource ParamLabel}" Text="Y 오프셋"/>
                    <TextBox x:Name="TbOriginOffsetY" Style="{StaticResource ParamTextBox}"/>
                    <TextBlock Style="{StaticResource UnitLabel}" Text="mm"/>
                    <TextBlock Style="{StaticResource RangeLabel}" Text="음수 가능. 기본값: 0"/>
                </StackPanel>

                <!-- 솔레노이드 설정 -->
                <TextBlock Style="{StaticResource SectionLabel}" Text="솔레노이드 설정"/>
                <Separator Margin="0,0,0,8"/>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource ParamLabel}" Text="솔레노이드 반전 (B접점)"/>
                    <CheckBox x:Name="ChkSolenoidInvert"
                              VerticalAlignment="Center"
                              FontSize="12"
                              Content="반전 (M3=OFF, M5=ON)"/>
                </StackPanel>
                <TextBlock Text="※ A접점(NO, 기본): M3=ON, M5=OFF  /  B접점(NC): M3=OFF, M5=ON"
                           FontSize="10" Foreground="#777" Margin="0,2,0,0"/>

                <!-- GRBL 기계 설정 -->
                <TextBlock Style="{StaticResource SectionLabel}" Text="GRBL 기계 설정 (연결 시 자동 전송)"/>
                <Separator Margin="0,0,0,8"/>
                <TextBlock Text="연결 직후 아래 값들이 GRBL EEPROM에 자동 저장됩니다. 분해능은 드라이버 마이크로스텝에 맞게 설정하세요."
                           FontSize="11" Foreground="#777" TextWrapping="Wrap" Margin="0,0,0,8"/>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource ParamLabel}" Text="하드 리밋 사용  ($21)"/>
                    <TextBox x:Name="TbHardLimitsEnable" Style="{StaticResource ParamTextBox}"/>
                    <TextBlock Style="{StaticResource UnitLabel}" Text="0/1"/>
                    <TextBlock Style="{StaticResource RangeLabel}" Text="리밋 스위치 없으면 0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource ParamLabel}" Text="홈잉 사용  ($22)"/>
                    <TextBox x:Name="TbHomingEnable" Style="{StaticResource ParamTextBox}"/>
                    <TextBlock Style="{StaticResource UnitLabel}" Text="0/1"/>
                    <TextBlock Style="{StaticResource RangeLabel}" Text="홈 센서 없으면 0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource ParamLabel}" Text="홈 방향 반전  ($23)"/>
                    <TextBox x:Name="TbHomingDirMask" Style="{StaticResource ParamTextBox}"/>
                    <TextBlock Style="{StaticResource UnitLabel}" Text="마스크"/>
                    <TextBlock Style="{StaticResource RangeLabel}" Text="0=Min방향(기본)  X=1  Y=2  XY=3"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource ParamLabel}" Text="홈 탐색 속도  ($25)"/>
                    <TextBox x:Name="TbHomingSeekRate" Style="{StaticResource ParamTextBox}"/>
                    <TextBlock Style="{StaticResource UnitLabel}" Text="mm/min"/>
                    <TextBlock Style="{StaticResource RangeLabel}" Text="1차 고속 탐색. 권장: 200~1000"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource ParamLabel}" Text="홈 확인 속도  ($24)"/>
                    <TextBox x:Name="TbHomingFeedRate" Style="{StaticResource ParamTextBox}"/>
                    <TextBlock Style="{StaticResource UnitLabel}" Text="mm/min"/>
                    <TextBlock Style="{StaticResource RangeLabel}" Text="2차 저속 정밀 확인. 권장: 10~50"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource ParamLabel}" Text="홈 디바운스  ($26)"/>
                    <TextBox x:Name="TbHomingDebounce" Style="{StaticResource ParamTextBox}"/>
                    <TextBlock Style="{StaticResource UnitLabel}" Text="ms"/>
                    <TextBlock Style="{StaticResource RangeLabel}" Text="스위치 채터링 방지. 기본: 250"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource ParamLabel}" Text="홈 풀오프  ($27)"/>
                    <TextBox x:Name="TbHomingPullOff" Style="{StaticResource ParamTextBox}"/>
                    <TextBlock Style="{StaticResource UnitLabel}" Text="mm"/>
                    <TextBlock Style="{StaticResource RangeLabel}" Text="스위치에서 후퇴 거리. 기본: 1.0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource ParamLabel}" Text="스텝 펄스 폭  ($0)"/>
                    <TextBox x:Name="TbStepPulseUs" Style="{StaticResource ParamTextBox}"/>
                    <TextBlock Style="{StaticResource UnitLabel}" Text="μs"/>
                    <TextBlock Style="{StaticResource RangeLabel}" Text="기본: 10 / A4988 최소: 2"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource ParamLabel}" Text="모터 유지 시간  ($1)"/>
                    <TextBox x:Name="TbStepIdleDelayMs" Style="{StaticResource ParamTextBox}"/>
                    <TextBlock Style="{StaticResource UnitLabel}" Text="ms"/>
                    <TextBlock Style="{StaticResource RangeLabel}" Text="255 = 항상 통전 (펀칭 중 위치 유지 권장)"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource ParamLabel}" Text="X steps/mm  ($100)"/>
                    <TextBox x:Name="TbStepsPerMmX" Style="{StaticResource ParamTextBox}"/>
                    <TextBlock Style="{StaticResource UnitLabel}" Text="steps/mm"/>
                    <TextBlock Style="{StaticResource RangeLabel}" Text="벨트GT2 20T 1/8: 80 / 리드스크류2mm 1/8: 800"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource ParamLabel}" Text="Y steps/mm  ($101)"/>
                    <TextBox x:Name="TbStepsPerMmY" Style="{StaticResource ParamTextBox}"/>
                    <TextBlock Style="{StaticResource UnitLabel}" Text="steps/mm"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource ParamLabel}" Text="X 최대 속도  ($110)"/>
                    <TextBox x:Name="TbMaxRateX" Style="{StaticResource ParamTextBox}"/>
                    <TextBlock Style="{StaticResource UnitLabel}" Text="mm/min"/>
                    <TextBlock Style="{StaticResource RangeLabel}" Text="권장: 1000 ~ 5000"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource ParamLabel}" Text="Y 최대 속도  ($111)"/>
                    <TextBox x:Name="TbMaxRateY" Style="{StaticResource ParamTextBox}"/>
                    <TextBlock Style="{StaticResource UnitLabel}" Text="mm/min"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource ParamLabel}" Text="X 가속도  ($120)"/>
                    <TextBox x:Name="TbAccelerationX" Style="{StaticResource ParamTextBox}"/>
                    <TextBlock Style="{StaticResource UnitLabel}" Text="mm/sec²"/>
                    <TextBlock Style="{StaticResource RangeLabel}" Text="권장: 50 ~ 500"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource ParamLabel}" Text="Y 가속도  ($121)"/>
                    <TextBox x:Name="TbAccelerationY" Style="{StaticResource ParamTextBox}"/>
                    <TextBlock Style="{StaticResource UnitLabel}" Text="mm/sec²"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource ParamLabel}" Text="X 최대 이동 거리  ($130)"/>
                    <TextBox x:Name="TbMaxTravelX" Style="{StaticResource ParamTextBox}"/>
                    <TextBlock Style="{StaticResource UnitLabel}" Text="mm"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource ParamLabel}" Text="Y 최대 이동 거리  ($131)"/>
                    <TextBox x:Name="TbMaxTravelY" Style="{StaticResource ParamTextBox}"/>
                    <TextBlock Style="{StaticResource UnitLabel}" Text="mm"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource ParamLabel}" Text="축 방향 반전  ($3)"/>
                    <CheckBox x:Name="ChkInvertX" Content="X" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <CheckBox x:Name="ChkInvertY" Content="Y" VerticalAlignment="Center"/>
                    <TextBlock Style="{StaticResource RangeLabel}" Text="X=1, Y=2, 둘 다=3"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource ParamLabel}" Text="리밋 핀 반전  ($5)"/>
                    <CheckBox x:Name="ChkLimitInvertX" Content="X" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <CheckBox x:Name="ChkLimitInvertY" Content="Y" VerticalAlignment="Center"/>
                    <TextBlock Style="{StaticResource RangeLabel}" Text="NC 센서면 체크. NO면 그대로"/>
                </StackPanel>

                <!-- 변환 엔진 -->
                <TextBlock Style="{StaticResource SectionLabel}" Text="변환 엔진"/>
                <Separator Margin="0,0,0,8"/>

                <!-- 엔진 선택 라디오 버튼 -->
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource ParamLabel}" Text="변환 엔진"/>
                    <RadioButton x:Name="RbManual"
                                 Content="Manual (내장 테이블)"
                                 VerticalAlignment="Center"
                                 Margin="0,0,16,0"
                                 Checked="EngineRadio_Changed"/>
                    <RadioButton x:Name="RbLibLouis"
                                 Content="liblouis (DLL)"
                                 VerticalAlignment="Center"
                                 Checked="EngineRadio_Changed"/>
                </StackPanel>

                <!-- liblouis 상태 표시 -->
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource ParamLabel}" Text="liblouis 상태"/>
                    <TextBlock x:Name="TbLibLouisStatus"
                               VerticalAlignment="Center"
                               FontSize="11"
                               FontWeight="Medium"/>
                </StackPanel>

                <!-- liblouis 테이블 선택 -->
                <StackPanel Orientation="Horizontal" Margin="0,4"
                            x:Name="PanelLibLouisTable">
                    <TextBlock Style="{StaticResource ParamLabel}" Text="liblouis 테이블"/>
                    <ComboBox x:Name="CbLibLouisTable"
                              Width="160"
                              VerticalAlignment="Center"
                              FontSize="12">
                        <ComboBoxItem Content="ko-g2.ctb  (한국어 약자)" Tag="ko-g2.ctb"/>
                        <ComboBoxItem Content="ko-g1.ctb  (한국어 정자)" Tag="ko-g1.ctb"/>
                    </ComboBox>
                </StackPanel>

                <!-- liblouis 설치 안내 (DLL 없을 때) -->
                <Border x:Name="PanelLibLouisGuide"
                        Background="#FFF9C4"
                        BorderBrush="#F9A825" BorderThickness="1"
                        CornerRadius="4" Padding="10,8"
                        Margin="0,6,0,0"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="liblouis DLL이 없습니다. 아래 위치에 배치하세요:"
                                   FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="  앱폴더\liblouis\liblouis.dll"
                                   FontSize="11" FontFamily="Consolas"/>
                        <TextBlock Text="  앱폴더\liblouis\tables\ko-g2.ctb  (외)"
                                   FontSize="11" FontFamily="Consolas"/>
                        <TextBlock Text="github.com/liblouis/liblouis/releases"
                                   FontSize="10" Foreground="#777" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ── 오류 메시지 ── -->
        <TextBlock x:Name="TbError"
                   Grid.Row="1"
                   Foreground="Red" FontSize="11"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"/>

        <!-- ── 버튼 행 ── -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button x:Name="BtnSave"    Style="{StaticResource ActionButton}"
                    Content="저장"
                    Background="#1565C0" Foreground="White"
                    Click="BtnSave_Click"/>
            <Button x:Name="BtnDefault" Style="{StaticResource ActionButton}"
                    Content="기본값"
                    Click="BtnDefault_Click"/>
            <Button x:Name="BtnCancel"  Style="{StaticResource ActionButton}"
                    Content="취소"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
